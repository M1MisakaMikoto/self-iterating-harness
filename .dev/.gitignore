# ---- 密钥与本地文件 ----
.env
.env.*
!.env.example
*.local.*
*secret*

# ---- 系统 / 编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/

# ---- 工具临时产物 ----
scripts/tmp/
*.tmp

# ---- 依赖目录（如需测试脚本时） ----
node_modules/
.venv/

# ---- serve_agent/serve_project 原则 ----
# serve_agent/ = 服务 coding agent（本仓库跟踪、项目忽略）；其中属于项目本地的部分两仓库都不跟踪
serve_agent/records/
serve_agent/skills/docs-writing/
serve_agent/skills/review/
# serve_project/ = agent 产出、服务项目（组合区，不在这里忽略）

# ---- 通用缓存产物（两仓库都不跟踪） ----
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
