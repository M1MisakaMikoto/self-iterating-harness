# ---- 密钥与本地文件 ----
.env
.env.*
!.env.example
*.local.*
*secret*

# ---- 系统 / 编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/

# ---- 工具临时产物 ----
scripts/tmp/
*.tmp

# ---- 依赖目录（如需测试脚本时） ----
node_modules/
.venv/

# ---- private/public 原则 ----
# private/ = UAC 用户辅助内容（分离区：仅本仓库跟踪）；其中属于项目本地的部分两仓库都不跟踪
private/records/
private/skills/docs-writing/
private/skills/review/
# public/ = MAC 模型辅助内容（组合区：项目仓库与本仓库都跟踪，故不在这里忽略）
